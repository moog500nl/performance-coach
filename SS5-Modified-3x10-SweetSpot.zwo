<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
    <author>Performance Coach</author>
    <name>SS-5 Modified — 3x10 Sweet Spot</name>
    <description>Base Phase reactivation sweet spot session. 3 blocks of 10 min at 87% FTP with 5 min Z1 recovery between each. Full WU (20 min) and CD (15 min). Total: 75 min. Template SS-5 modified — 3 of 4 blocks. If all 3 feel controlled, progress to 4x10 next session.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="sweet spot"/>
        <tag name="base"/>
        <tag name="SS-5"/>
    </tags>
    <workout>

        <!-- ══════════════════════════════════════════ -->
        <!--  WARM-UP  20 min                          -->
        <!-- ══════════════════════════════════════════ -->

        <!-- 1. Easy Z1 ramp  5 min -->
        <Warmup Duration="300" PowerLow="0.30" PowerHigh="0.55">
            <textevent timeoffset="0"   message="Warm-up: very easy for the first 5 min. Legs and lungs only just waking up."/>
            <textevent timeoffset="240" message="Start to pick up cadence a little. Target 85-90 rpm."/>
        </Warmup>

        <!-- 2. Z1→Z2 progressive build  5 min -->
        <Ramp Duration="300" PowerLow="0.55" PowerHigh="0.75">
            <textevent timeoffset="0"   message="Smooth build into Z2. No surging — let it rise steadily."/>
            <textevent timeoffset="240" message="Almost at Z2. HR rising comfortably. Good."/>
        </Ramp>

        <!-- 3. Z3 activation primer 1  1 min -->
        <SteadyState Duration="60" Power="0.80">
            <textevent timeoffset="0" message="First Z3 activation — 1 min. Wakes the system up."/>
        </SteadyState>

        <!-- 4. Z1 recovery  1 min -->
        <SteadyState Duration="60" Power="0.55">
            <textevent timeoffset="0" message="Easy. Let HR settle before the next primer."/>
        </SteadyState>

        <!-- 5. Z3 activation primer 2  1 min -->
        <SteadyState Duration="60" Power="0.80">
            <textevent timeoffset="0" message="Second Z3 activation. Should feel easier than the first."/>
        </SteadyState>

        <!-- 6. Sweet spot taste  30 sec -->
        <SteadyState Duration="30" Power="0.87">
            <textevent timeoffset="0" message="30 sec at sweet spot (87% FTP). Preview of the main set."/>
        </SteadyState>

        <!-- 7. Z1 settle before main set  6.5 min -->
        <SteadyState Duration="390" Power="0.50">
            <textevent timeoffset="0"   message="Easy spin. Let HR drop fully. Main set in ~6 min."/>
            <textevent timeoffset="300" message="1 min to main set. Target: 87% FTP (174W at FTP 200). HR should stabilise at 135-148 bpm during intervals — not above LTHR."/>
        </SteadyState>

        <!-- ══════════════════════════════════════════ -->
        <!--  MAIN SET  3×10 min Sweet Spot            -->
        <!--  87% FTP — 5 min Z1 recovery between      -->
        <!-- ══════════════════════════════════════════ -->

        <!-- ── INTERVAL 1 ── -->
        <SteadyState Duration="600" Power="0.87">
            <textevent timeoffset="0"   message="INTERVAL 1 of 3 — GO. 10 min at 87% FTP. First 2 min may feel hard. Settle in."/>
            <textevent timeoffset="120" message="2 min in. HR rising — aim to plateau around 135-148 bpm. Power steady, cadence 85-95 rpm."/>
            <textevent timeoffset="300" message="Halfway. How does it feel? RPE should be 6-7/10 — controlled effort, not desperate."/>
            <textevent timeoffset="480" message="2 min to go. Maintain. No surging to the line."/>
            <textevent timeoffset="570" message="30 sec. Finish clean and controlled."/>
        </SteadyState>

        <!-- ── RECOVERY 1 ── -->
        <SteadyState Duration="300" Power="0.50">
            <textevent timeoffset="0"   message="Recovery — 5 min easy. Let HR come down. Note how the interval felt."/>
            <textevent timeoffset="240" message="1 min to Interval 2. Same target. Match your power from interval 1."/>
        </SteadyState>

        <!-- ── INTERVAL 2 ── -->
        <SteadyState Duration="600" Power="0.87">
            <textevent timeoffset="0"   message="INTERVAL 2 of 3 — GO. Same power, same focus."/>
            <textevent timeoffset="120" message="2 min in. HR should plateau at a similar level to interval 1. Good sign."/>
            <textevent timeoffset="300" message="Halfway. Cadence honest — don't let it drop below 85 rpm."/>
            <textevent timeoffset="480" message="2 min to go. Stay composed."/>
            <textevent timeoffset="570" message="30 sec. Almost there."/>
        </SteadyState>

        <!-- ── RECOVERY 2 ── -->
        <SteadyState Duration="300" Power="0.50">
            <textevent timeoffset="0"   message="Recovery — 5 min easy. Last interval next."/>
            <textevent timeoffset="180" message="If you feel solid after 2 intervals with stable power — 4x10 is on for next Wednesday."/>
            <textevent timeoffset="240" message="1 min to final interval. Last one — make it count."/>
        </SteadyState>

        <!-- ── INTERVAL 3 ── -->
        <SteadyState Duration="600" Power="0.87">
            <textevent timeoffset="0"   message="INTERVAL 3 of 3 — FINAL. Same power. Same focus. Power drop of 5W is fine — don't chase it."/>
            <textevent timeoffset="120" message="2 min in. HR may be slightly higher than intervals 1-2 — normal at end of session."/>
            <textevent timeoffset="300" message="Halfway through the last one. You are doing it."/>
            <textevent timeoffset="480" message="2 min to go. Controlled finish."/>
            <textevent timeoffset="560" message="40 sec. Hold the power."/>
            <textevent timeoffset="590" message="10 sec. Hold it!"/>
        </SteadyState>

        <!-- ══════════════════════════════════════════ -->
        <!--  COOL-DOWN  15 min                        -->
        <!-- ══════════════════════════════════════════ -->

        <!-- 1. Progressive ramp down  5 min -->
        <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.75">
            <textevent timeoffset="0"  message="Main set DONE. Well done. Cool-down — 15 min easy from here."/>
            <textevent timeoffset="60" message="Let the power drop naturally. Cadence can ease off too."/>
        </Cooldown>

        <!-- 2. Easy Z1 spin  10 min -->
        <SteadyState Duration="600" Power="0.45">
            <textevent timeoffset="0"   message="Easy Z1 spin. HR coming down. Reflect: were all 3 intervals at similar power and HR?"/>
            <textevent timeoffset="300" message="5 min to go. If all 3 blocks felt controlled with stable power — next Wednesday is 4x10. You earned it."/>
            <textevent timeoffset="540" message="Almost done. Good session."/>
        </SteadyState>

    </workout>
</workout_file>
